#!/bin/sh
# pre-push フック: main へ push するとき、次の二つを止める。
#
# 1. プラグインの中身を変えたのに plugin.json の版を上げていない。版を書くと、書き換えるまで入れた人に
#    更新が届かない（このリポジトリは版を手で上げる）。初めての push では比べる相手が無いので見ない
# 2. 送る main の版に、v<版> のタグが無い（または送るコミットより後を指している）。版ごとにタグを打つ
#    （2026-11-02、作者の決定）。push.followTags を有効にしておけば、注釈つきのタグは main と一緒に送られる
#
# ブランチを消す push と、main 以外は見ない。

plugin_dir=plugins/wiki-style-article
manifest=$plugin_dir/.claude-plugin/plugin.json
zero=0000000000000000000000000000000000000000

version_at() {
  git show "$1:$manifest" 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = "$zero" ] && continue
  after=$(version_at "$local_sha")

  if [ -n "$after" ]; then
    tag=v$after
    if ! git rev-parse -q --verify "refs/tags/$tag^{commit}" >/dev/null; then
      echo "pre-push: 版 $after のタグ $tag が無い。git tag -a $tag -m \"$tag\" を打ってから push し直す。" >&2
      status=1
    elif ! git merge-base --is-ancestor "$tag" "$local_sha"; then
      echo "pre-push: タグ $tag が、送る main より後のコミットを指している。タグを打ち直してから push し直す。" >&2
      status=1
    fi
  fi

  [ "$remote_sha" = "$zero" ] && continue
  # 送り先のコミットが手元に無いと比べられない。fetch してから push し直すよう促す
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "pre-push: 送り先の main（$remote_sha）が手元に無い。git fetch してから push し直す。" >&2
    status=1
    continue
  fi
  git diff --quiet "$remote_sha" "$local_sha" -- "$plugin_dir" && continue
  before=$(version_at "$remote_sha")
  if [ "$before" = "$after" ]; then
    echo "pre-push: $plugin_dir の中身が変わったのに、$manifest の version が $after のまま。" >&2
    echo "pre-push: version を上げてからコミットし、push し直す（上げないと入れた人に更新が届かない）。" >&2
    status=1
  fi
done
exit $status
